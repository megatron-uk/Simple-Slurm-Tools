def isxterm():
	if os.environ['TERM'] in ['xterm', 'xterm-256color']:
		return True
	else:
		return False

class colour:
	def __init__(self):
		if isxterm():
			self.PURPLE = '\033[95m'
			self.CYAN = '\033[96m'
			self.DARKCYAN = '\033[36m'
			self.BLUE = '\033[94m'
			self.GREEN = '\033[92m'
			self.YELLOW = '\033[93m'
			self.RED = '\033[91m'
			self.BOLD = '\033[1m'
			self.UNDERLINE = '\033[4m'
			self.END = '\033[0m'
		else:
			self.PURPLE = ''
			self.CYAN = ''
			self.DARKCYAN = ''
			self.BLUE = ''
			self.GREEN = ''
			self.YELLOW = ''
			self.RED = ''
			self.BOLD = ''
			self.UNDERLINE = ''
			self.END = ''

# Colour class
