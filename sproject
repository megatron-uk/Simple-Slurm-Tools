def showJobSummary(slurmlimits = None, slurmjobs = None):
	print("")
	print(c.UNDERLINE + "Slurm Job Summary" + c.END)

	sj = SlurmJob()

	jobs_running = 0
	jobs_pending = 0
	jobs_total = 0

	cores_running = 0
	cores_pending = 0
	cores_total = 0

	gpu_running = 0
	gpu_pending = 0
	gpu_total = 0

	ram_running = 0
	ram_pending = 0
	ram_total = 0

	if len(slurmjobs) == 0:
		print(f"There are no running or pending jobs for this account_code")
		return

	# Work out job statistics
	for j in slurmjobs:
		jobs_total += 1

		if j['State'] == "PENDING":
			jobs_pending += 1
			cores_pending += j['ReqCPUS']
			cores_total += j['ReqCPUS']
			ram_pending += int(j['TotalMemory'])
			ram_total += int(j['TotalMemory'])
			gpu_pending += sj.tres_to_gpu(j['ReqTRES'])
			gpu_total += sj.tres_to_gpu(j['ReqTRES'])

		if j['State'] == "RUNNING":
			jobs_running += 1
			cores_running += j['AllocCPUS']
			cores_total += j['AllocCPUS']
			ram_running += int(j['TotalMemory'])
			ram_total += int(j['TotalMemory'])
			gpu_running += sj.tres_to_gpu(j['AllocTRES'])
			gpu_total += sj.tres_to_gpu(j['AllocTRES'])

	# Conditional formatting for Job numbers
	jobs_running_s = jobs_running
	jobs_pending_s = jobs_pending
	jobs_total_s = jobs_total
	jobs_pending_s = c.GREEN + f"{jobs_pending:13d}  " + c.END
	if ('GrpSubmit' in limits.keys()) and (limits['GrpSubmit']):
		if jobs_pending >= limits['GrpSubmit']:
			jobs_pending_s = c.RED + f"{jobs_pending:13d} f" + c.END
			notes_list.append('f')

	jobs_running_s = c.GREEN + f"{jobs_running:13d}  " + c.END
	if ("GrpJobs" in limits.keys()) and (limits['GrpJobs']):
		if jobs_running >= limits['GrpJobs']:
			jobs_running_s = c.RED + f"{jobs_running:13d} e" + c.END 
			notes_list.append('e')

	jobs_total_s = c.GREEN + f"{jobs_total:13d}  " + c.END

	# Conditional formatting for CPU core stats
	cores_running_s = cores_running
	cores_pending_s = cores_pending
	cores_total_s = cores_total
	if 'cores' in limits.keys():
		if cores_running >= limits['cores']:
			cores_running_s = c.RED + f"{cores_running:13d} a" + c.END
			notes_list.append('a')
		else:
			cores_running_s = c.GREEN + f"{cores_running:13d}  " + c.END
		if cores_pending >= limits['cores']:
			cores_pending_s = c.RED + f"{cores_pending:13d} b" + c.END
			notes_list.append('b')
		else:
			cores_pending_s = c.GREEN + f"{cores_pending:13d}  " + c.END
		if (cores_total) >= limits['cores']:
			cores_total_s = c.RED + f"{cores_total:13d}  " + c.END
		else:
			cores_total_s = c.GREEN + f"{cores_total:13d}  " + c.END

	# Conditional formatting for GPU card stats
	gpu_running_s = gpu_running
	gpu_pending_s = gpu_pending
	gpu_total_s = gpu_total
	if 'gpu' in limits.keys():
		if gpu_running >= limits['gpu']:
			gpu_running_s = c.RED + f"{gpu_running:13d} c" + c.END
			notes_list.append('c')
		else:
			gpu_running_s = c.GREEN + f"{gpu_running:13d}  " + c.END
		if gpu_pending >= limits['gpu']:
			gpu_pending_s = c.RED + f"{gpu_pending:13d} d" + c.END
			notes_list.append('d')
		else:
			gpu_pending_s = c.GREEN + f"{gpu_pending:13d}  " + c.END
		if gpu_total >= limits['gpu']:
			gpu_total_s = c.RED + f"{gpu_total:13d}  " + c.END
		else:
			gpu_total_s = c.GREEN + f"{gpu_total:13d}  " + c.END

	print(c.UNDERLINE + "Metric" + c.END + "       " + c.UNDERLINE + "Running" + c.END + " ?       " + c.UNDERLINE + "Pending" + c.END + " ?         " + c.UNDERLINE + "Total"+ c.END + " ?")
	print(f"Jobs   {jobs_running_s} {jobs_pending_s} {jobs_total_s}")
	print(f"Cores  {cores_running_s} {cores_pending_s} {cores_total_s}")
	print(f"GPU    {gpu_running_s} {gpu_pending_s} {gpu_total_s}")
	print(f"RAM    {ram_running:13d}   {ram_pending:13d}   {ram_total:13d}")

def showPendingSummary(slurmjobs):

	pending_reasons = {}

	sj = SlurmJob()

	for j in slurmjobs:
		if j['State'] == "PENDING":
			reason = sj.get_reason(j['JobID'])
			if reason:
				if reason not in pending_reasons.keys():
					pending_reasons[reason] = {
						'jobs' : 1,
					}
				else:
					pending_reasons[reason]['jobs'] += 1

	if len(pending_reasons.keys()) > 0:
		print("")
		print(c.UNDERLINE + "Pending Job Reasons" + c.END)
		for reason in pending_reasons.keys():
			d = pending_reasons[reason]
			print(c.RED + f"{d['jobs']}" + c.END + " jobs pending due to [" + c.RED + f"{reason}" + c.END + "]")

def showNotes():

	if len(notes_list) == 0:
		return

	print("")
	print(c.UNDERLINE + "Explanation" + c.END)

	notes_list.sort()
	added = []
	for n in notes_list:
		if n not in added:
			print(c.RED + f"{n}." + c.END + f" {notes[n]}")
			added.append(n)

